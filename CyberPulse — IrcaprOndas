//@version=6
indicator("CyberPulse — IrcaprOndas (Todas las MAs)", shorttitle="CP IrcaprOndas", overlay=true)

// --- ENTRADAS ---
tipoMA      = input.string("SSMA", "Tipo de Media Móvil", options=[
  "SMA", "EMA", "WMA", "RMA", "DEMA", "TEMA", 
  "HMA", "VWMA", "KAMA", "ALMA", "ZLEMA", "SMMA", "LSMA", "SSMA"
  ])
srcInput    = input.source(close, "Fuente de Precio")
lonInicial  = input.int(4, "Longitud Inicial", minval=1)
incremento  = input.int(2, "Incremento entre líneas", minval=1)
grisColor   = color.rgb(255, 255, 255, 90)

// --- ESTADO POR INSTANCIA (evita que KAMA/SSMA compartan estado entre las 50 longitudes) ---
var int N_LINEAS      = 50
var float[] kamaState = array.new_float(N_LINEAS, na)
var float[] ssmaPrev1 = array.new_float(N_LINEAS, na)
var float[] ssmaPrev2 = array.new_float(N_LINEAS, na)

// --- FUNCIONES AUXILIARES DE CÁLCULO ---
f_dema(src, len) => 
    e1 = ta.ema(src, len)
    2 * e1 - ta.ema(e1, len)

f_tema(src, len) => 
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    3 * (e1 - e2) + ta.ema(e2, len)

f_zlema(src, len) =>
    lag = math.floor((len - 1) / 2)
    src_lag = src - nz(src[lag], src)
    ta.ema(src + src_lag, len)

f_kama(src, len, idx) =>
    change = math.abs(src - nz(src[len], src))
    volatility = math.sum(math.abs(src - nz(src[1], src)), len)
    er = volatility != 0 ? change / volatility : 0.0
    fastSC = 2.0 / (2 + 1)
    slowSC = 2.0 / (30 + 1)
    sc = math.pow(er * (fastSC - slowSC) + slowSC, 2)
    prev = array.get(kamaState, idx)
    base = na(prev) ? src : prev
    kama = base + sc * (src - base)
    array.set(kamaState, idx, kama)
    kama

f_ssma(src, len, idx) =>
    arg = math.sqrt(2) * math.pi / len
    a1 = math.exp(-arg)
    b1 = 2 * a1 * math.cos(arg)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1 - c2 - c3
    p1 = array.get(ssmaPrev1, idx)
    p2 = array.get(ssmaPrev2, idx)
    prev1 = na(p1) ? src : p1
    prev2 = na(p2) ? src : p2
    ss = c1 * (src + nz(src[1], src)) / 2 + c2 * prev1 + c3 * prev2
    array.set(ssmaPrev2, idx, prev1)
    array.set(ssmaPrev1, idx, ss)
    ss

// --- CALCULADORA MA GENERAL ---
f_calc(len, idx) =>
    switch tipoMA
        "EMA"   => ta.ema(srcInput, len)
        "WMA"   => ta.wma(srcInput, len)
        "RMA"   => ta.rma(srcInput, len)
        "DEMA"  => f_dema(srcInput, len)
        "TEMA"  => f_tema(srcInput, len)
        "HMA"   => ta.hma(srcInput, len)
        "VWMA"  => ta.vwma(srcInput, len)
        "KAMA"  => f_kama(srcInput, len, idx)
        "ALMA"  => ta.alma(srcInput, len, 0.85, 6)
        "ZLEMA" => f_zlema(srcInput, len)
        "SMMA"  => ta.rma(srcInput, len)
        "LSMA"  => ta.linreg(srcInput, len, 0)
        "SSMA"  => f_ssma(srcInput, len, idx)
        => ta.sma(srcInput, len)

// --- DIBUJO DE LA CINTA (idx fijo 0-49, longitud = lonInicial + idx*incremento) ---
